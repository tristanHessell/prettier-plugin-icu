{
  "name": "prettier-plugin-icu",
  "version": "0.0.1",
  "description": "Prettier plugin for formatting ICU strings",
  "keywords": [
    "prettier",
    "icu"
  ],
  "license": "MIT",
  "author": "tristan.hessell@gmail.com",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "spellcheck": "cspell .",
    "markdownlint": "markdownlint-cli2 \"**/*.md\"",
    "lint": "npm run format:check && npm run spellcheck && npm run markdownlint",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix",
      "cspell"
    ],
    "*.{js,jsx,ts,tsx,json,jsonc,yml,yaml}": [
      "prettier --write",
      "cspell"
    ]
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@formatjs/icu-messageformat-parser": "^2.11.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "cspell": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "^0.19.1",
    "re2js": "^2.9.1"
  }
}
